{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Token Market Setup",
  "version": "0.1.0",
  "identifier": "cn.tokensmarket.setup",
  "build": {
    "frontendDist": "../src/tauri-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Token Market Setup",
        "width": 900,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
